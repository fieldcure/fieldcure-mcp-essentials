<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>FieldCure.Mcp.Essentials</RootNamespace>
    <AssemblyName>fieldcure-mcp-essentials</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Version>2.6.1</Version>
    <PackageId>FieldCure.Mcp.Essentials</PackageId>

    <Authors>Jong Hyun Kim</Authors>
    <Company>Fieldcure Co., Ltd.</Company>
    <Copyright>Copyright (c) 2026 Fieldcure Co., Ltd.</Copyright>
    <Description>Essential MCP tools — web search (news/images/scholar/patents with SerpApi or Serper), web/document fetching and file downloads, Wolfram|Alpha computational knowledge with native MathML, shell, JavaScript sandbox, file I/O, and persistent memory for any MCP client.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fieldcure/fieldcure-mcp-essentials</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fieldcure/fieldcure-mcp-essentials</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mcp;mcp-server;ai;dotnet;web-search;web-fetch;download;document-parsing;pdf;docx;wolfram-alpha;mathml;shell;javascript;file-io;memory;sqlite</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Logo.png</PackageIcon>
    <PackageReleaseNotes>v2.6.1: Metadata-only patch. .mcp/server.json now declares 9 environment variables for MCP Server Registry discovery — ESSENTIALS_SEARCH_ENGINE (choices: bing/duckduckgo/serper/tavily/serpapi, default bing), ESSENTIALS_SEARCH_API_KEY, SERPER_API_KEY, SERPAPI_API_KEY, TAVILY_API_KEY, WOLFRAM_APPID, ESSENTIALS_MEMORY_PATH, ESSENTIALS_DOWNLOAD_DIRECTORY, ESSENTIALS_SETTINGS_PATH. Pure descriptor change — runtime behaviour unchanged; ADR-001 credential resolution chain (CLI → env → Elicit → fallback-consent Elicit → soft fail) is unaffected. Pack-time VerifyServerJsonVersion MSBuild target catches drift between csproj &lt;Version&gt; and the two version fields in .mcp/server.json. publish-mcp-registry.yml GitHub Actions workflow (manual workflow_dispatch) drives the MCP Server Registry update via OIDC — run AFTER NuGet indexing because the registry validates the published nupkg README's mcp-name line.</PackageReleaseNotes>

    <PackageType>McpServer</PackageType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fieldcure-mcp-essentials</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.4.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.*" />
    <PackageReference Include="Jint" Version="4.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.*" />
    <PackageReference Include="FieldCure.DocumentParsers" Version="2.*" />
    <PackageReference Include="ReverseMarkdown" Version="5.*" />
    <PackageReference Include="SmartReader" Version="0.11.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FieldCure.Mcp.Essentials.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="Logo.png" Pack="true" PackagePath="" />
    <None Include=".mcp/server.json" Pack="true" PackagePath=".mcp/" />
  </ItemGroup>


  <!-- Sync check: .mcp/server.json's "version" fields must match csproj <Version>.
       The JSON descriptor is metadata for the MCP Server Registry; if the two
       drift, the registry listing reports the wrong version even though the
       published nupkg itself is correct. Runs before pack and errors out on
       the literal token `"version": "$(Version)"` so a mismatched dev pack
       fails immediately with a descriptive message. -->
  <Target Name="VerifyServerJsonVersion" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_ServerJsonContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\.mcp\server.json'))</_ServerJsonContent>
      <_ExpectedVersionToken>"version": "$(Version)"</_ExpectedVersionToken>
    </PropertyGroup>
    <Error Condition="!$(_ServerJsonContent.Contains($(_ExpectedVersionToken)))"
           Text=".mcp/server.json version is out of sync with csproj &lt;Version&gt;$(Version)&lt;/Version&gt;. Update both 'version' fields in .mcp/server.json to match before packing." />
  </Target>

</Project>
